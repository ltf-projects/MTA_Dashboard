# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env asla git'e commit edilmez (.gitignore içinde).

# --- MQTT Broker Ayarları ---
MQTT_HOST=temelsondajtakip.com
MQTT_PORT=8883
MQTT_USERNAME=root
MQTT_PASSWORD=

# TLS ile bağlan (8883 için true).
MQTT_TLS=true
MQTT_REJECT_UNAUTHORIZED=false

# Tüm cihazlar tek topic'e yayın yapar; ayrım box_id ile yapılır.
# Broker'daki gerçek topic adı "Hoytek-IOT/" (sonunda eğik çizgi); "#" joker'i
# hem eğik çizgili hem çizgisiz yayını yakalar.
# Tırnak şart: tırnaksız yazılırsa dotenv "#" sonrasını yorum sayar.
MQTT_TOPIC="Hoytek-IOT/#"
BOX_ID=20

# Makine Verileri için istek/cevap topic'leri. Boş bırakılırsa BOX_ID kullanılarak
# reqAnalogData/20 ve resAnalogData/20 biçiminde otomatik oluşturulur.
MQTT_ANALOG_REQUEST_TOPIC=
MQTT_ANALOG_RESPONSE_TOPIC=
# Analog veriyi kaç milisaniyede bir iste (minimum 250 ms):
ANALOG_REQUEST_INTERVAL_MS=1000

# Köprü sunucusunun çalışacağı port (barındırma sağlayıcısı PORT enjekte
# ederse o önceliklidir, bu sadece yerel geliştirme için).
BRIDGE_PORT=4001

# Prod'da yalnızca gerçek arayüz adresine izin vermek için, örn:
# ALLOWED_ORIGIN=https://mta-dashboard.vercel.app
ALLOWED_ORIGIN=*

# --- Geçmiş Grafik (PostgreSQL) ---
# Örnekler `sondaj_ornekleri` tablosuna yazılır. Tablo ve sütunlar köprü
# açılışında otomatik oluşturulur; elle SQL çalıştırmanız gerekmez.
#
# Tanımlı değilse geçmiş kaydı KAPALI olur; canlı izleme normal çalışır.
# DATABASE_URL=postgres://kullanici:sifre@localhost:5432/mta
DATABASE_URL=

# Barındırılan Postgres'lerin çoğu TLS ister (Neon, Supabase, Railway...).
DATABASE_SSL=false

# En fazla kaç ms'de bir satır yazılsın (paketler daha sık gelse de):
HISTORY_SAMPLE_MS=10000

# --- Arayüz (Vite) ---
# Köprü farklı bir makinede/portta ise:
# VITE_BRIDGE_URL=http://localhost:4001
